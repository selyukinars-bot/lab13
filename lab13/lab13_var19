# Лабораторная работа №13. Вариант 19 (повышенный): кратчайший путь BFS
# Структуры данных: dict (список смежности) + deque (очередь FIFO)
from collections import deque


def shortest_path(graph, start, end):
    if start not in graph or end not in graph:
        return None
    prev = {start: None}            # посещённые вершины и откуда пришли
    queue = deque([start])
    while queue:
        cur = queue.popleft()
        if cur == end:
            path = []
            while cur is not None:
                path.append(cur)
                cur = prev[cur]
            return path[::-1]
        for nxt in graph[cur]:
            if nxt not in prev:
                prev[nxt] = cur
                queue.append(nxt)
    return None                     # пути нет


def run_tests():
    g = {"A": ["B", "C"], "B": ["D"], "C": ["D"], "D": ["E"], "E": [], "F": []}
    assert shortest_path(g, "A", "E") == ["A", "B", "D", "E"]  # обычный
    assert shortest_path(g, "A", "A") == ["A"]        # граничный: старт = финиш
    assert shortest_path(g, "A", "F") is None         # пути нет
    assert shortest_path(g, "A", "Z") is None         # вершины нет
    assert shortest_path({}, "A", "B") is None        # пустой граф
    print("Тесты пройдены")


if __name__ == "__main__":
    run_tests()
    graph = {"A": ["B", "C"], "B": ["D"], "C": ["D"], "D": []}
    print("Путь A->D:", shortest_path(graph, "A", "D"))
